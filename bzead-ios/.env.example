# ============================================================
# bzead-ios — build-time environment
# ============================================================
# These values are embedded into the buyer web bundle at build time
# (Bzeadstore-main/.env drives the actual Vite build — this file documents
# what the iOS wrapper itself needs).
#
# OneSignal App ID for push notifications (public, safe to embed).
# The web app initialises OneSignal from JS; no native injection needed.
ONESIGNAL_APP_ID=02f9a15b-ca1c-4ab2-8404-8a8cdb9afef9

# The web app's Vite env lives in Bzeadstore-main/.env — copy it from the
# example and fill in the real public keys before building:
#   cd ../Bzeadstore-main && cp .env.example .env
#
# Required for a working app bundle:
#   VITE_SUPABASE_URL         (real value already in .env.example)
#   VITE_SUPABASE_ANON_KEY    (fill in your anon key)
#   VITE_STRIPE_PUBLISHABLE_KEY (fill in your publishable key)
#   VITE_ONESIGNAL_APP_ID     (real value already in .env.example)
#   VITE_DOMAIN / VITE_PUBLIC_APP_URL (https://www.bzead.com)
