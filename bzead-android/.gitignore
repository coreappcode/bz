# Android — keep source/config tracked, ignore build outputs & secrets.
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml
android/app/release/
android/app/debug/

# Keystores and signing certs (NEVER commit private signing material)
*.keystore
*.jks
*.pem
# Also keep any stale/old google-services files out of the repo.
android/app/google-services.OLD-*.json
android/app/google-services.json
!android/app/google-services.json.example

# Build artifacts
dist/

# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
